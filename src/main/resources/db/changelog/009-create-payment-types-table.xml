<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="009-1" author="omeralkan">
        <createTable tableName="payment_types">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="min_installment" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="max_installment" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
            <column name="is_active" type="TINYINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
            <column name="updated_by" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

    <changeSet id="009-2" author="omeralkan">
        <insert tableName="payment_types">
            <column name="code" value="PESIN"/>
            <column name="name" value="Peşin Ödeme"/>
            <column name="min_installment" valueNumeric="1"/>
            <column name="max_installment" valueNumeric="1"/>
            <column name="created_at" valueDate="NOW()"/>
            <column name="created_by" value="system"/>
        </insert>
        <insert tableName="payment_types">
            <column name="code" value="TAKSITLI"/>
            <column name="name" value="Taksitli Ödeme"/>
            <column name="min_installment" valueNumeric="2"/>
            <column name="max_installment" valueNumeric="12"/>
            <column name="created_at" valueDate="NOW()"/>
            <column name="created_by" value="system"/>
        </insert>
    </changeSet>

</databaseChangeLog>